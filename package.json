{
  "name": "esoterica",
  "private": true,
  "version": "0.1.0",
  "description": "Universo Esotérico — frontend React + Sanity Studio",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "lint": "pnpm --dir frontend lint",
    "studio": "pnpm --dir studio-universo-esoterico dev",
    "deploy": "pnpm build && firebase deploy --only hosting",
    "deploy:studio": "pnpm --dir studio-universo-esoterico deploy"
  },
  "engines": {
    "node": ">=22"
  }
}